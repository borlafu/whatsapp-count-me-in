# Copy to .env and fill in. Every variable is optional, but without at least one
# alert channel the bot can only print re-link instructions to its log.
#
# SECURITY: a QR code or pairing code grants full control of the linked WhatsApp
# account. Only send alerts to a private chat and a mailbox you control, and keep
# this file out of version control.

# --- Pairing (recommended) ---------------------------------------------------
# Your WhatsApp number in international format: digits only, no "+" or spaces.
# When set, the bot requests an 8-character pairing code you can type into
# WhatsApp > Linked devices > Link with phone number instead.
WA_PHONE_NUMBER=

# --- Telegram alerts ---------------------------------------------------------
# Create a bot with @BotFather, then send it a message and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# --- Email alerts ------------------------------------------------------------
# Any SMTP server works (e.g. Gmail with an app password on smtp.gmail.com:587).
# Set all of HOST, FROM and TO, or leave the whole block empty.
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_SECURE=false
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASS=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
